[
  {
    "start": 0.52,
    "end": 1.0,
    "text": "谁懂啊"
  },
  {
    "start": 1.0,
    "end": 2.4,
    "text": "死了三年的白月光回来了"
  },
  {
    "start": 2.4,
    "end": 3.17,
    "text": "还挽着亲哥"
  },
  {
    "start": 3.17,
    "end": 4.017,
    "text": "等你当众喊大嫂"
  },
  {
    "start": 5.85,
    "end": 6.813,
    "text": "她改名方牧兰"
  },
  {
    "start": 6.813,
    "end": 7.843,
    "text": "嘴上装作不认识"
  },
  {
    "start": 7.843,
    "end": 9.724,
    "text": "一个眼神就把三年前的旧情全招了"
  },
  {
    "start": 23.127,
    "end": 23.427,
    "text": "天呐"
  },
  {
    "start": 23.427,
    "end": 24.617,
    "text": "狠话还没落地"
  },
  {
    "start": 24.617,
    "end": 26.313,
    "text": "下一秒两个人直接亲上了"
  },
  {
    "start": 28.043,
    "end": 29.163,
    "text": "前脚还装陌生人"
  },
  {
    "start": 29.163,
    "end": 29.938,
    "text": "看他挨打"
  },
  {
    "start": 29.938,
    "end": 31.297,
    "text": "她想都没想就冲过去挡下"
  },
  {
    "start": 38.2,
    "end": 39.2,
    "text": "嘴上装不认识"
  },
  {
    "start": 39.2,
    "end": 40.425,
    "text": "见他挨打却下意识冲去护着"
  },
  {
    "start": 40.425,
    "end": 41.2,
    "text": "这一下伪装露馅"
  },
  {
    "start": 41.2,
    "end": 41.938,
    "text": "男主全懂了"
  },
  {
    "start": 42.493,
    "end": 43.568,
    "text": "偏偏再见面"
  },
  {
    "start": 43.568,
    "end": 44.548,
    "text": "她已经穿上婚服"
  },
  {
    "start": 44.548,
    "end": 45.442,
    "text": "要嫁给他哥"
  },
  {
    "start": 46.809,
    "end": 47.49,
    "text": "她忙着复仇"
  },
  {
    "start": 47.49,
    "end": 48.37,
    "text": "他追着真相"
  },
  {
    "start": 48.37,
    "end": 49.26,
    "text": "前任变大嫂"
  },
  {
    "start": 49.26,
    "end": 49.74,
    "text": "家人们"
  },
  {
    "start": 49.74,
    "end": 51.026,
    "text": "这瓜谁能不迷糊？"
  }
]
